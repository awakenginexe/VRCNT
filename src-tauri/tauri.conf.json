{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "VRCNT",
    "mainBinaryName": "VRCNT",
    "version": "5.9.0",
    "identifier": "com.vrcnt.app",
    "build": {
        "beforeDevCommand": "",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "",
        "frontendDist": "../dist"
    },
    "app": {
        "enableGTKAppId": false,
        "windows": [
            {
                "label": "main",
                "title": "VRCNT",
                "width": 1498,
                "height": 900,
                "minWidth": 1498,
                "minHeight": 711,
                "resizable": true,
                "maximizable": true,
                "minimizable": true,
                "closable": true,
                "visible": true,
                "decorations": false,
                "transparent": false,
                "shadow": true,
                "center": true
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$LOCALDATA/VRCNTData/fonts/**",
                    "$LOCALDATA/VRCNT-NextData/fonts/**",
                    "$APPDATA/VRCNTData/fonts/**",
                    "$APPDATA/VRCNT-NextData/fonts/**",
                    "$RESOURCE/**"
                ]
            },
            "capabilities": [
                "default",
                "vrct-capability"
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": "nsis",
        "createUpdaterArtifacts": true,
        "publisher": "awakenginexe",
        "copyright": "Copyright 2026 awakenginexe. Portions Copyright 2023 misyaguziya.",
        "licenseFile": "../LICENSE",
        "shortDescription": "VRCNT",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "externalBin": [
            "bin/VRCNT-backend"
        ],
        "resources": {
            "../dist": "frontend",
            "bin/_internal": "_internal"
        },
        "windows": {
            "nsis": {
                "template": "nsis/template.nsi",
                "installMode": "currentUser",
                "displayLanguageSelector": true
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4NTYzNUI0QUI2RTI4RkMKUldUOEtHNnJ0RFZXYUt4L1cwOVhIL1NtZXJGQkxzZkVVYXMrWGJZQlZ5NFNPdldRMk9RdUkrVCsK",
            "endpoints": [
                "https://github.com/awakenginexe/VRCNT/releases/latest/download/latest.json"
            ]
        }
    }
}