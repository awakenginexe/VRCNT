                                              Fill="{DynamicResource InstallerAccentBrush}" Stretch="Uniform" Width="16" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- AMD Logo Badge -->
                                    <Border Width="24" Height="24" Background="#261214" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="AMD">
                                        <Path Data="M18.324 9.137l1.559 1.56h2.556v2.557L24 14.814V9.137zM2 9.52l-2 4.96h1.309l.37-.982H3.9l.408.982h1.338L3.432 9.52zm4.209 0v4.955h1.238v-3.092l1.338 1.562h.188l1.338-1.556v3.091h1.238V9.52H10.47l-1.592 1.845L7.287 9.52zm6.283 0v4.96h2.057c1.979 0 2.88-1.046 2.88-2.472 0-1.36-.937-2.488-2.747-2.488zm1.237.91h.792c1.17 0 1.63.711 1.63 1.57 0 .728-.372 1.572-1.616 1.572h-.806zm-10.985.273l.791 1.932H2.008zm17.137.307l-1.604 1.603v2.25h2.246l1.604-1.607h-2.246z"
                                              Fill="#EF4444" Stretch="Uniform" Width="15" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding CpuTitle}" FontSize="{DynamicResource InstallerCardTitleFontSize}" FontWeight="Bold" Foreground="{DynamicResource InstallerTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Border Background="{DynamicResource InstallerSurfaceMutedBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CpuStatus}" Foreground="{DynamicResource InstallerTextMutedBrush}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <!-- Selected Indicator Chip -->
                                    <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCpuSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Background" Value="#1A3B54" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource InstallerAccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="✓ Selected" Foreground="{DynamicResource InstallerAccentBrush}" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                            <!-- Card Body -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <Border Height="130" CornerRadius="6" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="1" Margin="0,0,0,8" SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/VRCNT.Setup;component/Assets/cpu_ceos.png" Stretch="UniformToFill" AlignmentY="Top" />
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="{Binding CpuBody}" Foreground="{DynamicResource InstallerTextMutedBrush}" TextWrapping="Wrap" FontSize="12" LineHeight="18" />
                            </StackPanel>
                            <!-- Specs Row -->
                            <Border Grid.Row="2" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <DockPanel>
                                    <TextBlock Text="{Binding CpuSize}" Foreground="{DynamicResource InstallerTextBrush}" FontSize="11" FontWeight="Medium" DockPanel.Dock="Left" />
                                    <TextBlock Text="{Binding CpuTime}" Foreground="{DynamicResource InstallerTextDimBrush}" FontSize="11" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </RadioButton>

                    <!-- CUDA Runtime Card -->
                    <RadioButton Grid.Column="2" GroupName="Runtime" Style="{StaticResource CudaRuntimeCardStyle}" IsChecked="{Binding IsCudaSelected}" IsEnabled="{Binding CanSelectCudaRadio}" AutomationProperties.Name="{Binding CudaTitle}" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Card Header -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <!-- NVIDIA Logo Badge -->
                                    <Border Width="24" Height="24" Background="#123324" BorderBrush="{DynamicResource InstallerCudaAccentBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="NVIDIA">
                                        <Path Data="M8.948 8.798v-1.43a6.7 6.7 0 0 1 .424-.018c3.922-.124 6.493 3.374 6.493 3.374s-2.774 3.851-5.75 3.851c-.398 0-.787-.062-1.158-.185v-4.346c1.528.185 1.837.857 2.747 2.385l2.04-1.714s-1.492-1.952-4-1.952a6.016 6.016 0 0 0-.796.035m0-4.735v2.138l.424-.027c5.45-.185 9.01 4.47 9.01 4.47s-4.08 4.964-8.33 4.964c-.37 0-.733-.035-1.095-.097v1.325c.3.035.61.062.91.062 3.957 0 6.82-2.023 9.593-4.408.459.371 2.34 1.263 2.73 1.652-2.633 2.208-8.772 3.984-12.253 3.984-.335 0-.653-.018-.971-.053v1.864H24V4.063zm0 10.326v1.131c-3.657-.654-4.673-4.46-4.673-4.46s1.758-1.944 4.673-2.262v1.237H8.94c-1.528-.186-2.73 1.245-2.73 1.245s.68 2.412 2.739 3.11M2.456 10.9s2.164-3.197 6.5-3.533V6.201C4.153 6.59 0 10.653 0 10.653s2.35 6.802 8.948 7.42v-1.237c-4.84-.6-6.492-5.936-6.492-5.936z"
                                              Fill="{DynamicResource InstallerCudaAccentBrush}" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding CudaTitle}" FontSize="{DynamicResource InstallerCardTitleFontSize}" FontWeight="Bold" Foreground="{DynamicResource InstallerTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Border Background="#16382A" BorderBrush="{DynamicResource InstallerCudaAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CudaStatus}" Foreground="{DynamicResource InstallerCudaAccentBrush}" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                    <!-- Selected Indicator Chip -->
                                    <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCudaSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Background" Value="#143D28" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource InstallerCudaAccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="✓ Selected" Foreground="{DynamicResource InstallerCudaAccentBrush}" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                            <!-- Card Body -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <Border Height="130" CornerRadius="6" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="1" Margin="0,0,0,8" SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/VRCNT.Setup;component/Assets/cuda_ceo.jpg" Stretch="UniformToFill" AlignmentY="Top" />
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="{Binding CudaBody}" Foreground="{DynamicResource InstallerTextMutedBrush}" TextWrapping="Wrap" FontSize="12" LineHeight="18" />
                                <TextBlock Text="{Binding CudaAdvisory}" Foreground="{DynamicResource InstallerWarningBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                            <!-- Specs Row -->
                            <Border Grid.Row="2" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <DockPanel>
                                    <TextBlock Text="{Binding CudaSize}" Foreground="{DynamicResource InstallerTextBrush}" FontSize="11" FontWeight="Medium" DockPanel.Dock="Left" />
                                    <TextBlock Text="{Binding CudaTime}" Foreground="{DynamicResource InstallerTextDimBrush}" FontSize="11" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </RadioButton>
                </Grid>

                <!-- Advanced CUDA Override Warning (If Inconclusive / Blocked) -->
                <StackPanel Grid.Row="3">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RequiresAdvancedCudaOverride}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Background="#261318" BorderBrush="{DynamicResource InstallerErrorBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock Text="{Binding AdvancedCudaWarning}" Foreground="{DynamicResource InstallerErrorBrush}" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left" />
                            <Button Content="{Binding EnableAdvancedCudaOverrideText}" Command="{Binding EnableAdvancedCudaOverrideCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="10,4" MinHeight="26" FontSize="11" Margin="8,0,0,0" DockPanel.Dock="Right" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- VIEW: Options / Summary -->
            <StackPanel x:Name="Options" VerticalAlignment="Center" MaxWidth="580" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource InstallerPageTransitionStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Options}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding OptionsTitle}" FontSize="{DynamicResource InstallerHeadingFontSize}" FontWeight="Bold" Foreground="{DynamicResource InstallerTextBrush}" />
                <TextBlock Text="{Binding OptionsBody}" Foreground="{DynamicResource InstallerTextMutedBrush}" Margin="0,8,0,16" TextWrapping="Wrap" />
                <Border Background="{DynamicResource InstallerSurfaceBrush}" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource InstallerCardRadius}" Padding="{DynamicResource InstallerCardPadding}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding InstallLocationLabel}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource InstallerTextBrush}" />
                        <DockPanel Margin="0,7,0,0" LastChildFill="True">
                            <Button Content="{Binding BrowseInstallDirectoryText}" Command="{Binding BrowseInstallDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Margin="8,0,0,0" MinHeight="30" />
                            <TextBox Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChooseInstallDirectory}" Background="{DynamicResource InstallerCanvasBrush}" Foreground="{DynamicResource InstallerTextBrush}" BorderBrush="{DynamicResource InstallerBorderBrush}" Padding="8,5" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding InstallLocationLabel}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource InstallerSurfaceBrush}" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource InstallerCardRadius}" Padding="{DynamicResource InstallerCardPadding}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedRuntimeTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource InstallerTextBrush}" />
                        <TextBlock Text="{Binding SelectedRuntimeSize}" Foreground="{DynamicResource InstallerTextMutedBrush}" Margin="0,6,0,0" FontSize="12" />
                        <TextBlock Text="{Binding SelectedRuntimeTime}" Foreground="{DynamicResource InstallerTextDimBrush}" Margin="0,2,0,0" FontSize="11" />
                        <CheckBox Content="{Binding LaunchAfterSetupText}" IsChecked="{Binding LaunchAfterSetup}" Margin="0,16,0,0">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSwitch}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- VIEW: Installation Progress -->
            <StackPanel x:Name="Progress" VerticalAlignment="Center" MaxWidth="540" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource InstallerPageTransitionStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Progress}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding ProgressTitle}" FontSize="{DynamicResource InstallerHeadingFontSize}" FontWeight="Bold" Foreground="{DynamicResource InstallerTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding SelectedRuntimeTitle}" Foreground="{DynamicResource InstallerTextMutedBrush}" Margin="0,4,0,16" HorizontalAlignment="Center" FontSize="12" />

                <!-- Phase & Progress Details Card -->
                <Border Background="{DynamicResource InstallerSurfaceBrush}" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding CurrentPhaseText}" Foreground="{DynamicResource InstallerAccentBrush}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ProgressDetail}" Foreground="{DynamicResource InstallerTextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TransferSizeText}" Foreground="{DynamicResource InstallerTextDimBrush}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <!-- Progress Bar & Percentage -->
                <Grid Margin="0,0,0,12">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" Height="{DynamicResource InstallerProgressHeight}" IsIndeterminate="{Binding IsProgressIndeterminate}" />
                    <TextBlock Text="{Binding ProgressPercentText}" Foreground="{DynamicResource InstallerTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="10" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProgressIndeterminate}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Real-time Activity History Panel -->
                <Border Background="#070A10" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding ActivityHistoryTitle}" Foreground="{DynamicResource InstallerTextMutedBrush}" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Left" />
                            <Border Background="#0F3824" BorderBrush="{DynamicResource InstallerSuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                <TextBlock Text="● LIVE" Foreground="{DynamicResource InstallerSuccessBrush}" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </DockPanel>
                        <ScrollViewer x:Name="ProgressScrollViewer" Height="112" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="ProgressScrollViewer_ScrollChanged">
                            <ItemsControl ItemsSource="{Binding ProgressHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,5">
                                            <TextBlock Text="› " Foreground="{DynamicResource InstallerAccentBrush}" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource InstallerTextDimBrush}" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- VIEW: Error State -->
            <StackPanel x:Name="Error" VerticalAlignment="Center" MaxWidth="540" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource InstallerPageTransitionStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Error}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="46" Height="46" Background="#261318" BorderBrush="{DynamicResource InstallerErrorBrush}" BorderThickness="1.5" CornerRadius="10" Margin="0,0,0,16" HorizontalAlignment="Left">
                    <TextBlock Text="!" Foreground="{DynamicResource InstallerErrorBrush}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding ErrorTitle}" FontSize="{DynamicResource InstallerHeadingFontSize}" FontWeight="Bold" Foreground="{DynamicResource InstallerTextBrush}" />
                <TextBlock Text="{Binding ErrorBody}" Foreground="{DynamicResource InstallerTextMutedBrush}" Margin="0,8,0,12" TextWrapping="Wrap" />
                <Border Background="{DynamicResource InstallerSurfaceBrush}" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <TextBlock Text="{Binding ErrorDetail}" Foreground="{DynamicResource InstallerErrorBrush}" TextWrapping="Wrap" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11" />
                </Border>
                <Button Content="{Binding ErrorActionText}" Command="{Binding ErrorActionCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" MinWidth="130" />
            </StackPanel>

            <!-- VIEW: Complete / Success -->
            <StackPanel x:Name="Complete" VerticalAlignment="Center" MaxWidth="580" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource InstallerPageTransitionStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Complete}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="52" Height="52" Background="#143328" BorderBrush="{DynamicResource InstallerSuccessBrush}" BorderThickness="1.5" CornerRadius="12" Margin="0,0,0,16" HorizontalAlignment="Left">
                    <TextBlock Text="✓" Foreground="{DynamicResource InstallerSuccessBrush}" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding CompleteTitle}" FontSize="{DynamicResource InstallerHeadingFontSize}" FontWeight="Bold" Foreground="{DynamicResource InstallerTextBrush}" />
                <TextBlock Text="{Binding CompleteBody}" Foreground="{DynamicResource InstallerTextMutedBrush}" Margin="0,8,0,18" TextWrapping="Wrap" LineHeight="20" FontSize="13" />

                <!-- Installed Edition Card -->
                <Border Background="{DynamicResource InstallerSurfaceBrush}" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource InstallerCardRadius}" Padding="16,12" Margin="0,0,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding InstalledEditionLabel}" Foreground="{DynamicResource InstallerTextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedRuntimeTitle}" Foreground="{DynamicResource InstallerTextBrush}" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="{Binding InstallPath}" Foreground="{DynamicResource InstallerTextDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#16382A" BorderBrush="{DynamicResource InstallerSuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveStatusText}" Foreground="{DynamicResource InstallerSuccessBrush}" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Border>

                <Button Content="{Binding LaunchVrcntText}" Command="{Binding LaunchCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" MinWidth="140" />
            </StackPanel>
        </Grid>

        <!-- ==================== ACTION FOOTER ==================== -->
        <Border Grid.Row="3" Background="{DynamicResource InstallerSurfaceBrush}" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="0,1,0,0" Padding="20,14,20,16">
            <DockPanel LastChildFill="False">
                <!-- Secondary Back Button (Left) -->
                <Button Content="{Binding BackText}" Command="{Binding BackCommand}" DockPanel.Dock="Left" Height="36" VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Welcome}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Progress}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Error}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Complete}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Primary Action Buttons (Right) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Secondary Close button on Complete page -->
                    <Button Content="{Binding CloseText}" Command="{Binding CloseCommand}" Margin="0,0,8,0" Height="36" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Complete}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{Binding InstallText}" Command="{Binding InstallCommand}" Height="36" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Options}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{Binding ContinueText}" Command="{Binding ContinueCommand}" Height="36" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Welcome}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Language}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Runtime}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
