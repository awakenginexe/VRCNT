<Window x:Class="VRCNT.Setup.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VRCNT.Setup.Views"
        Title="{Binding AppTitle}" Icon="pack://application:,,,/VRCNT.Setup;component/Assets/icon.png" Width="780" Height="560" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" WindowStyle="None"
        Background="{DynamicResource InstallerCanvasBrush}" Foreground="{DynamicResource InstallerTextBrush}"
        BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="1">
    <Window.Resources>
        <Style x:Key="InstallerPageTransitionStyle" TargetType="StackPanel">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Visibility}" Value="Visible" />
                        <Condition Binding="{Binding DataContext.UseReducedMotion, RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="8" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Custom Dark Titlebar -->
            <RowDefinition Height="42" />
            <!-- Row 1: Wizard Step Progress Indicator -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Main Content View -->
            <RowDefinition Height="*" />
            <!-- Row 3: Action Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ambient Decorative VRCNT Background Lighting -->
        <Canvas Grid.RowSpan="4" IsHitTestVisible="False" ClipToBounds="True">
            <!-- Top-Left Electric Cyan Ambient Glow -->
            <Ellipse Width="480" Height="360" Canvas.Left="-120" Canvas.Top="-100" Opacity="0.22">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.4,0.4">
                        <GradientStop Color="#00D2FF" Offset="0" />
                        <GradientStop Color="#0284C7" Offset="0.45" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Bottom-Right Deep Purple Ambient Glow -->
            <Ellipse Width="440" Height="340" Canvas.Right="-100" Canvas.Bottom="-80" Opacity="0.18">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.6,0.6">
                        <GradientStop Color="#8B5CF6" Offset="0" />
                        <GradientStop Color="#4338CA" Offset="0.5" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Center Subtle Accent Aura -->
            <Ellipse Width="360" Height="240" Canvas.Left="200" Canvas.Top="140" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#38BDF8" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- ==================== HEADER / TITLEBAR ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource InstallerSurfaceBrush}" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="0,0,0,1" Padding="14,0,8,0">
            <Grid>
                <!-- Left: Branding & App Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Width="24" Height="24" Background="#142334" BorderBrush="{DynamicResource InstallerAccentBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,8,0">
                        <Image Source="pack://application:,,,/VRCNT.Setup;component/Assets/icon.png" Width="18" Height="18" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="{Binding AppTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource InstallerTextBrush}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource InstallerSurfaceMutedBrush}" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v5.15.0" Foreground="{DynamicResource InstallerTextMutedBrush}" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <!-- Right: Language Selector & Window Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- Language Selector Dropdown -->
                    <ComboBox WindowChrome.IsHitTestVisibleInChrome="True" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name" MinWidth="110" Height="28" Margin="0,0,12,0" AutomationProperties.Name="{Binding LanguageTitle}" />

                    <!-- Window Control Buttons (Minimize, Close) -->
                    <Button WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" Style="{StaticResource SecondaryButtonStyle}" Width="32" Height="28" Padding="0" MinHeight="0" Margin="0,0,4,0" ToolTip="Minimize">
                        <Path Data="M0 6 L10 6" Stroke="{DynamicResource InstallerTextMutedBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="32" Height="28" Padding="0" MinHeight="0" ToolTip="Close">
                        <Path Data="M0 0 L8 8 M8 0 L0 8" Stroke="{DynamicResource InstallerTextMutedBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== WIZARD STEP INDICATOR ==================== -->
        <Border Grid.Row="1" Background="#0A0E18" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="0,0,0,1" Padding="24,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Error}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid HorizontalAlignment="Center" MaxWidth="560">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="20" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- STEP 1: Welcome -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource InstallerSurfaceMutedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource InstallerBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Welcome}">
                                        <Setter Property="Background" Value="{DynamicResource InstallerAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource InstallerAccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Language}">
                                        <Setter Property="Background" Value="{DynamicResource InstallerAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource InstallerAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="1" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource InstallerTextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Welcome}">
                                            <Setter Property="Foreground" Value="#050B14" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Language}">
                                            <Setter Property="Foreground" Value="#050B14" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding WelcomeTitle}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource InstallerTextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Welcome}">
                                        <Setter Property="Foreground" Value="{DynamicResource InstallerTextBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Language}">
                                        <Setter Property="Foreground" Value="{DynamicResource InstallerTextBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- CONNECTOR 1-2 -->
                <Border Grid.Column="1" Height="1" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource InstallerBorderBrush}" />

                <!-- STEP 2: Runtime Selection -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource InstallerSurfaceMutedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource InstallerBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Runtime}">
                                        <Setter Property="Background" Value="{DynamicResource InstallerAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource InstallerAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="2" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource InstallerTextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Runtime}">
                                            <Setter Property="Foreground" Value="#050B14" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding RuntimeTitle}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource InstallerTextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Runtime}">
                                        <Setter Property="Foreground" Value="{DynamicResource InstallerTextBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- CONNECTOR 2-3 -->
                <Border Grid.Column="3" Height="1" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource InstallerBorderBrush}" />

                <!-- STEP 3: Options -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource InstallerSurfaceMutedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource InstallerBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Options}">
                                        <Setter Property="Background" Value="{DynamicResource InstallerAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource InstallerAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="3" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource InstallerTextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Options}">
                                            <Setter Property="Foreground" Value="#050B14" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding OptionsTitle}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource InstallerTextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Options}">
                                        <Setter Property="Foreground" Value="{DynamicResource InstallerTextBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- CONNECTOR 3-4 -->
                <Border Grid.Column="5" Height="1" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource InstallerBorderBrush}" />

                <!-- STEP 4: Install -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource InstallerSurfaceMutedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource InstallerBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Progress}">
                                        <Setter Property="Background" Value="{DynamicResource InstallerAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource InstallerAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="4" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource InstallerTextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Progress}">
                                            <Setter Property="Foreground" Value="#050B14" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding ProgressTitle}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource InstallerTextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Progress}">
                                        <Setter Property="Foreground" Value="{DynamicResource InstallerTextBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- CONNECTOR 4-5 -->
                <Border Grid.Column="7" Height="1" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource InstallerBorderBrush}" />

                <!-- STEP 5: Complete -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource InstallerSurfaceMutedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource InstallerBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Complete}">
                                        <Setter Property="Background" Value="{DynamicResource InstallerSuccessBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource InstallerSuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="✓" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource InstallerTextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Complete}">
                                            <Setter Property="Foreground" Value="#050B14" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding CompleteTitle}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource InstallerTextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Complete}">
                                        <Setter Property="Foreground" Value="{DynamicResource InstallerSuccessBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Row="2" Margin="{DynamicResource InstallerPageMargin}" KeyboardNavigation.TabNavigation="Cycle">

            <!-- VIEW: Welcome -->
            <StackPanel x:Name="Welcome" VerticalAlignment="Center" MaxWidth="580" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource InstallerPageTransitionStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Welcome}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="56" Height="56" Background="#142838" BorderBrush="{DynamicResource InstallerAccentBrush}" BorderThickness="1.5" CornerRadius="14" Margin="0,0,0,20" HorizontalAlignment="Left">
                    <Image Source="pack://application:,,,/VRCNT.Setup;component/Assets/icon.png" Width="44" Height="44" Stretch="Uniform" />
                </Border>
                <TextBlock Text="{Binding WelcomeTitle}" FontSize="{DynamicResource InstallerHeadingFontSize}" FontWeight="Bold" Foreground="{DynamicResource InstallerTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding WelcomeBody}" Foreground="{DynamicResource InstallerTextMutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20" FontSize="13" />
            </StackPanel>

            <!-- VIEW: Language Step -->
            <StackPanel x:Name="LanguageStep" VerticalAlignment="Center" MaxWidth="580" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource InstallerPageTransitionStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Language}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding LanguageTitle}" FontSize="{DynamicResource InstallerHeadingFontSize}" FontWeight="Bold" Foreground="{DynamicResource InstallerTextBrush}" />
                <TextBlock Text="{Binding LanguageBody}" Foreground="{DynamicResource InstallerTextMutedBrush}" Margin="0,8,0,16" TextWrapping="Wrap" />
                <Border Background="{DynamicResource InstallerSurfaceBrush}" BorderBrush="{DynamicResource InstallerBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource InstallerCardRadius}" Padding="{DynamicResource InstallerCardPadding}">
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name" AutomationProperties.Name="{Binding LanguageTitle}" />
                </Border>
            </StackPanel>

            <!-- VIEW: Runtime Selection (CPU vs CUDA) -->
            <Grid x:Name="RuntimeSelection">
                <Grid.RenderTransform>
                    <TranslateTransform X="0" Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static local:InstallerPage.Runtime}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top: GPU Detection Intelligence Banner -->
                <Border Grid.Row="0" Background="#121F24" BorderBrush="#1C3835" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="M4 11 L10 2 L8 8 L14 8 L6 18 L8 12 Z" Fill="{DynamicResource InstallerSuccessBrush}" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding GpuDetectionState}" Foreground="{DynamicResource InstallerTextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding ConfirmedTargetText}" Foreground="{DynamicResource InstallerAccentBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <!-- Center: Side-by-Side Runtime Cards -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CPU Runtime Card -->
                    <RadioButton Grid.Column="0" GroupName="Runtime" Style="{StaticResource RuntimeCardStyle}" IsChecked="{Binding IsCpuSelected}" IsEnabled="{Binding CanChangeRuntimeSelection}" AutomationProperties.Name="{Binding CpuTitle}" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Card Header -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <!-- Intel Logo Badge -->
                                    <Border Width="24" Height="24" Background="#0C2036" BorderBrush="{DynamicResource InstallerAccentBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Intel">
