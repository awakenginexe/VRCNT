{
  "name": "vrcnt",
  "private": true,
  "version": "5.14.0",
  "type": "module",
  "scripts": {
    "setup-python": "bat\\install.bat",
    "build-python": "bat\\build.bat",
    "build-python-cuda": "bat\\build_cuda.bat",
    "build-backend:cpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build_backend.ps1 -Variant cpu -OutputPath src-tauri\\bin",
    "build-backend:cuda": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build_backend.ps1 -Variant cuda -OutputPath build\\backend\\cuda",
    "build-runtime-shell": "npm run vite-build && npm run tauri -- build --no-bundle",
    "stage-runtime:cpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\stage_runtime.ps1 -Variant cpu",
    "stage-runtime:cuda": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\stage_runtime.ps1 -Variant cuda",
    "build-runtime-payloads": "npm run task-kill && npm run clean && npm run update-version && npm run build-backend:cpu && npm run build-backend:cuda && npm run build-runtime-shell && npm run stage-runtime:cpu && npm run stage-runtime:cuda",
    "test:runtime-payloads": "python -m unittest src-python/tests/test_runtime_payload_boundaries.py -v",
    "vite": "vite",
    "vite-build": "vite build",
    "vite-preview": "vite preview",
    "tauri": "tauri",
    "tauri-build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build_tauri.ps1",
    "tauri-dev": "tauri dev",
    "task-kill": "python utils\\task_kill.py",
    "clean": "python utils\\clean.py",
    "update-version": "python utils\\update_version.py",
    "prepare-installer-tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\prepare_installer_tools.ps1",
    "dev": "npm run task-kill && npm run clean && npm run update-version && npm run build-python && npm run vite-build && npm run dev-ui",
    "dev-cuda": "npm run task-kill && npm run clean && npm run update-version && npm run build-python-cuda && npm run vite-build && npm run dev-ui",
    "dev-ui": "npm run task-kill && npm-run-all --parallel vite tauri-dev",
    "test:ui": "node --test src-ui/logics/common/__tests__/*.test.js src-ui/views/app/config_page/sidebar_section/__tests__/*.test.js src-ui/views/app/config_page/setting_section/setting_box/*/__tests__/*.test.js src-ui/views/app/main_page/sidebar_section/main_function_switch/__tests__/*.test.js src-ui/views/app/main_page/main_section/__tests__/*.test.js",
    "analyze-error": "node utils/analyze_ui_error.js",
    "build": "npm run task-kill && npm run clean && npm run update-version && npm run build-python && npm run vite-build && npm run prepare-installer-tools && npm run tauri-build",
    "build-cuda": "npm run task-kill && npm run clean && npm run update-version && npm run build-python-cuda && npm run vite-build && npm run prepare-installer-tools && npm run tauri-build",
    "release": "npm run build-cuda"
  },
  "dependencies": {
    "@babel/standalone": "7.27.0",
    "@tauri-apps/api": "2.5.0",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-fs": "2.2.1",
    "@tauri-apps/plugin-global-shortcut": "2.2.0",
    "@tauri-apps/plugin-http": "2.4.3",
    "@tauri-apps/plugin-opener": "2.2.6",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "2.2.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "2.1.1",
    "flag-icons": "^7.3.2",
    "i18next": "25.0.1",
    "jotai": "2.12.3",
    "js-base64": "3.7.7",
    "jszip": "3.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "5.0.0",
    "react-i18next": "15.5.1",
    "react-resizable-layout": "0.7.2",
    "react-toastify": "11.0.5",
    "sass": "1.79.4",
    "semver": "7.7.1"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "4.1.2",
    "@tauri-apps/cli": "2.5.0",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "npm-run-all": "4.1.5",
    "source-map": "0.7.4",
    "vite": "6.4.3",
    "vite-plugin-svgr": "4.3.0"
  }
}
